# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Kunci hanya dipakai di server, tidak pernah berawalan NEXT_PUBLIC_.

# Google Cloud: aktifkan HANYA Places API (New), batasi kunci ke API itu (PRD 9.1 langkah 1 sampai 4).
GOOGLE_MAPS_API_KEY=

# Upstash Redis (Vercel Marketplace): rate limit + penghitung kuota bulanan per SKU.
# Tanpa ini: dev memakai penghitung memori; production MENOLAK permintaan (gagal tertutup, melindungi target Rp0).
# Dari Vercel Marketplace (Storage > Upstash Redis) variabelnya terisi otomatis dengan nama KV_REST_API_URL dan
# KV_REST_API_TOKEN; kode menerima kedua pasang nama.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Batas bulanan internal per SKU Google (kuota gratis 1.000, sisakan margin). Default 950.
MONTHLY_SKU_CAP=950

# Foto di kartu hasil. Default mati (hemat kuota foto 1.000/bulan). "on" memuat foto hanya saat kartu hampir terlihat:
# sekitar 2 foto per layar HP dan 8 per layar desktop untuk tiap pencarian.
LIST_PHOTOS=off
